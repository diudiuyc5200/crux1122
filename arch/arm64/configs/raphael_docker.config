# Extra config for the "docker" flavour of the Zundamon 4.14 raphael kernel.
#
# Merged on top of raphael_defconfig by the CI docker build only, so the
# standard kernel keeps the stock (more conservative) configuration.
#
# What this buys you: Linux namespaces (UTS/IPC/PID/NET/USER), the cgroup
# controllers containers expect, veth/bridge/vxlan for bridge networking,
# iptables NAT/masquerade for port publishing, overlayfs for image layers and
# seccomp filters for runc.

# --- namespaces -------------------------------------------------------------
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# --- cgroups ----------------------------------------------------------------
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y

# --- networking -------------------------------------------------------------
CONFIG_VETH=y
CONFIG_MACVLAN=y
CONFIG_VXLAN=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_TUN=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_NAT_MASQUERADE_IPV4=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP_NF_TARGET_REDIRECT=y

# --- container plumbing -----------------------------------------------------
CONFIG_OVERLAY_FS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_POSIX_MQUEUE=y
