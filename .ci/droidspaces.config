# Droidspaces / Docker-in-container kernel fragment
# Target: crux-marisa A16 (4.14.357-openela), defconfig: crux_defconfig

# --- Namespaces (FHANDLE/PID_NS also fixed directly in crux_defconfig) ---
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
# FHANDLE forced off in crux_defconfig (fragment cannot express =n; PYVERIFY only checks =y symbols)

# --- Cgroups v1 controllers needed by docker/lxc ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_BLK_CGROUP=y
CONFIG_POSIX_MQUEUE=y

# --- Filesystem / rootfs ---
CONFIG_OVERLAY_FS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_FUSE_FS=y

# --- Networking ---
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_TUN=y
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_NETBIOS_NS=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_SET=y
CONFIG_IP_VS=y
CONFIG_IP_VS_NFCT=y
CONFIG_NET_CLS_CGROUP=y

# --- Execution / sandbox support ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_INOTIFY_USER=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y

# --- GPU (kgsl built-in; turnip/Mesa used from container) ---
CONFIG_QCOM_KGSL=y

# --- KernelSU (in-tree drivers/kernelsu, default y; force built-in) ---
CONFIG_KSU=y
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y

# --- Networking additions (run #15 audit: missing) ---
CONFIG_MACVLAN=y
CONFIG_IPV6=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- FCM3 VINTF kernel compliance (fixes boot-time "device internal problem" dialog) ---
CONFIG_AUDIT=y
# --- Crash forensics (parity with stock) ---

# VINTF FCM5 kernel requirement: matrix demands QUOTA2_LOG=y (stock crux
# defconfig has it off; art17 stock /proc/config.gz shows y via vendor build).
CONFIG_NETFILTER_XT_MATCH_QUOTA2_LOG=y

# --- VINTF FCM5 explicit requirement: matrix demands IKHEADERS=y
# (DISALLOW_CONFIG_IKHEADERS_IS_N); stock v1 had it on via vendor build.
CONFIG_IKHEADERS=y

# --- v13: stock-parity compat stubs (visible in /proc/config.gz) ---
CONFIG_ANDROID_LOW_MEMORY_KILLER=y
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
